<Window x:Class="LenjExchange.Desktop.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="clr-namespace:LenjExchange.Desktop.ViewModels"
        Title="{Binding AppTitle}" Width="1360" Height="860" MinWidth="1100" MinHeight="700"
        WindowStartupLocation="CenterScreen" Icon="/Assets/lenj.ico"
        FontFamily="{StaticResource AppFont}" FontSize="13" FlowDirection="RightToLeft"
        Background="{StaticResource BackgroundBrush}" Foreground="{StaticResource TextBrush}">
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="230" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>

        <!-- Sidebar (appears on the right in RTL) -->
        <DockPanel Grid.Column="0" Background="{StaticResource PrimaryBrush}"
                   Visibility="{Binding IsSignedIn, Converter={StaticResource BoolToVis}}">
            <StackPanel DockPanel.Dock="Top" Margin="16,20,16,16">
                <Border Background="White" CornerRadius="30" Width="60" Height="60" HorizontalAlignment="Right" Margin="0,0,0,10">
                    <Image Source="/Assets/lenj-logo.png" Width="46" Height="46" RenderOptions.BitmapScalingMode="HighQuality" />
                </Border>
                <TextBlock Text="سامانه مالی لنج" Foreground="White" FontSize="20" FontWeight="Bold" />
                <TextBlock Text="LENJ Exchange Manager" Foreground="#C7D3E3" FontSize="11" FlowDirection="LeftToRight" HorizontalAlignment="Right" />
            </StackPanel>
            <StackPanel DockPanel.Dock="Bottom" Margin="16">
                <TextBlock Text="{Binding UserDisplay}" Foreground="#C7D3E3" TextWrapping="Wrap" Margin="0,0,0,8" />
                <Button Content="خروج از حساب" Command="{Binding SignOutCommand}" Style="{StaticResource SecondaryButton}" />
            </StackPanel>
            <ScrollViewer VerticalScrollBarVisibility="Auto">
                <ItemsControl ItemsSource="{Binding NavItems}">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate DataType="{x:Type vm:NavItem}">
                            <RadioButton GroupName="nav" Style="{StaticResource NavButton}" Content="{Binding Title}"
                                         Command="{Binding DataContext.NavigateCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                         CommandParameter="{Binding Key}" />
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </ScrollViewer>
        </DockPanel>

        <Grid Grid.Column="1" Margin="24,18">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>
            <TextBlock Grid.Row="0" Text="{Binding CurrentPage.Title}" Style="{StaticResource PageTitle}" />
            <ContentControl Grid.Row="1" Content="{Binding CurrentPage}" />
        </Grid>
    </Grid>
</Window>
