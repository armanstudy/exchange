<UserControl x:Class="LenjExchange.Desktop.Views.CustomersView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:v="clr-namespace:LenjExchange.Desktop.Views">
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="340" />
        </Grid.ColumnDefinitions>
        <DockPanel Grid.Column="0" Margin="0,0,12,0">
            <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Margin="0,0,0,6">
                <TextBox Text="{Binding Search, UpdateSourceTrigger=PropertyChanged}" Width="260" Margin="0,0,8,0" />
                <Button Content="جستجو" Command="{Binding FindCommand}" IsDefault="True" Margin="0,0,8,0" />
                <CheckBox Content="نمایش غیرفعال‌ها" IsChecked="{Binding IncludeInactive}" VerticalAlignment="Center" />
            </StackPanel>
            <v:MessageBar DockPanel.Dock="Top" />
            <DataGrid ItemsSource="{Binding Items}" SelectedItem="{Binding Selected}" AutoGenerateColumns="False" IsReadOnly="True">
                <DataGrid.Columns>
                    <DataGridTextColumn Header="کد" Binding="{Binding Code}" />
                    <DataGridTextColumn Header="نام" Binding="{Binding FullName}" Width="*" />
                    <DataGridTextColumn Header="تلفن" Binding="{Binding Phone}" />
                    <DataGridTextColumn Header="مانده (هر ارز جدا)" Binding="{Binding Balances}" Width="*" />
                    <DataGridTextColumn Header="وضعیت" Binding="{Binding ActiveText}" />
                </DataGrid.Columns>
            </DataGrid>
        </DockPanel>

        <Border Grid.Column="1" Style="{StaticResource Card}" VerticalAlignment="Top">
            <StackPanel>
                <TextBlock Text="{Binding FormTitle}" Style="{StaticResource SectionTitle}" />
                <TextBlock Text="نام و نام خانوادگی / شرکت *" Style="{StaticResource FieldLabel}" />
                <TextBox Text="{Binding FullName, UpdateSourceTrigger=PropertyChanged}" />
                <TextBlock Text="تلفن" Style="{StaticResource FieldLabel}" />
                <TextBox Text="{Binding Phone, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource LtrInput}" />
                <TextBlock Text="نشانی" Style="{StaticResource FieldLabel}" />
                <TextBox Text="{Binding Address, UpdateSourceTrigger=PropertyChanged}" />
                <TextBlock Text="یادداشت" Style="{StaticResource FieldLabel}" />
                <TextBox Text="{Binding Notes, UpdateSourceTrigger=PropertyChanged}" AcceptsReturn="True" Height="60" TextWrapping="Wrap" />
                <WrapPanel Margin="0,12,0,0">
                    <Button Content="ذخیره" Command="{Binding SaveCommand}" Margin="0,0,6,6" />
                    <Button Content="مشتری جدید" Command="{Binding NewCommand}" Style="{StaticResource SecondaryButton}" Margin="0,0,6,6" />
                </WrapPanel>
                <TextBlock Text="عملیات روی مشتری انتخاب‌شده" Style="{StaticResource FieldLabel}" Margin="0,10,0,4" />
                <WrapPanel>
                    <Button Content="ثبت رسید" Command="{Binding NewReceiptCommand}" Style="{StaticResource SecondaryButton}" Margin="0,0,6,6" />
                    <Button Content="صورتحساب" Command="{Binding StatementCommand}" Style="{StaticResource SecondaryButton}" Margin="0,0,6,6" />
                    <Button Content="فعال/غیرفعال" Command="{Binding ToggleActiveCommand}" Style="{StaticResource SecondaryButton}" Margin="0,0,6,6" />
                    <Button Content="حذف" Command="{Binding DeleteCommand}" Style="{StaticResource DangerButton}" Margin="0,0,6,6" />
                </WrapPanel>
            </StackPanel>
        </Border>
    </Grid>
</UserControl>
