<UserControl x:Class="LenjExchange.Desktop.Views.CasesView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:v="clr-namespace:LenjExchange.Desktop.Views">
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="430" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>
        <DockPanel Grid.Column="0" Margin="0,0,12,0">
            <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Margin="0,0,0,6">
                <ComboBox ItemsSource="{Binding StatusOptions}" SelectedItem="{Binding StatusFilter}" Width="170" Margin="0,0,6,0" />
                <TextBox Text="{Binding Search, UpdateSourceTrigger=PropertyChanged}" Width="140" Margin="0,0,6,0" />
                <Button Content="نمایش" Command="{Binding FindCommand}" IsDefault="True" />
            </StackPanel>
            <DataGrid ItemsSource="{Binding Items}" SelectedItem="{Binding Selected}" AutoGenerateColumns="False" IsReadOnly="True">
                <DataGrid.Columns>
                    <DataGridTextColumn Header="پرونده" Binding="{Binding CaseNumber}" />
                    <DataGridTextColumn Header="مشتری" Binding="{Binding Customer}" Width="*" />
                    <DataGridTextColumn Header="وضعیت" Binding="{Binding Status}" />
                    <DataGridTextColumn Header="تاریخ" Binding="{Binding Created}" />
                </DataGrid.Columns>
            </DataGrid>
        </DockPanel>

        <DockPanel Grid.Column="1">
            <v:MessageBar DockPanel.Dock="Top" />
            <Border DockPanel.Dock="Top" Style="{StaticResource Card}">
                <StackPanel>
                    <TextBlock Text="{Binding Summary}" TextWrapping="Wrap" LineHeight="22" />
                    <ItemsControl ItemsSource="{Binding Issues}" Margin="0,6,0,0">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate><TextBlock Text="{Binding StringFormat='⚠ {0}'}" Foreground="{StaticResource DangerBrush}" TextWrapping="Wrap" /></DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                    <WrapPanel Margin="0,8,0,0">
                        <Button Content="به‌روزرسانی" Command="{Binding RefreshDetailCommand}" Style="{StaticResource SecondaryButton}" Margin="0,0,6,0" />
                        <Button Content="علامت‌گذاری مغایرت" Command="{Binding FlagDiscrepancyCommand}" Style="{StaticResource SecondaryButton}" Margin="0,0,6,0" />
                        <Button Content="برگشت رویداد انتخاب‌شده" Command="{Binding ReverseEventCommand}" Style="{StaticResource DangerButton}" Margin="0,0,6,0"
                                Visibility="{Binding CanReverse, Converter={StaticResource BoolToVis}}" />
                        <Button Content="ابطال پرونده" Command="{Binding CancelCommand}" Style="{StaticResource DangerButton}"
                                Visibility="{Binding CanReverse, Converter={StaticResource BoolToVis}}" />
                    </WrapPanel>
                </StackPanel>
            </Border>
            <TabControl>
                <TabItem Header="خط زمانی">
                    <DataGrid ItemsSource="{Binding Timeline}" SelectedItem="{Binding SelectedEvent}" AutoGenerateColumns="False" IsReadOnly="True">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="تاریخ" Binding="{Binding Date}" />
                            <DataGridTextColumn Header="مرحله" Binding="{Binding Kind}" />
                            <DataGridTextColumn Header="عنوان" Binding="{Binding Title}" Width="*" />
                            <DataGridTextColumn Header="مبلغ" Binding="{Binding Amount}" />
                            <DataGridTextColumn Header="وضعیت" Binding="{Binding Status}" />
                        </DataGrid.Columns>
                    </DataGrid>
                </TabItem>
                <TabItem Header="اسناد حسابداری">
                    <DataGrid ItemsSource="{Binding Journal}" AutoGenerateColumns="False" IsReadOnly="True">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="شماره" Binding="{Binding EntryNumber}" />
                            <DataGridTextColumn Header="تاریخ" Binding="{Binding Date}" />
                            <DataGridTextColumn Header="نوع" Binding="{Binding Type}" />
                            <DataGridTextColumn Header="وضعیت" Binding="{Binding Status}" />
                            <DataGridTextColumn Header="شرح" Binding="{Binding Description}" Width="*" />
                            <DataGridTextColumn Header="ردیف‌ها" Binding="{Binding Lines}" Width="2*" />
                        </DataGrid.Columns>
                    </DataGrid>
                </TabItem>
            </TabControl>
        </DockPanel>
    </Grid>
</UserControl>
