<UserControl x:Class="LenjExchange.Desktop.Views.UsersView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:v="clr-namespace:LenjExchange.Desktop.Views">
    <TabControl>
        <TabItem Header="کاربران">
            <Grid Margin="0,8,0,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="360" />
                </Grid.ColumnDefinitions>
                <DockPanel Grid.Column="0" Margin="0,0,12,0">
                    <v:MessageBar DockPanel.Dock="Top" />
                    <DataGrid ItemsSource="{Binding Items}" SelectedItem="{Binding Selected}" AutoGenerateColumns="False" IsReadOnly="True">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="نام کاربری" Binding="{Binding UserName}" />
                            <DataGridTextColumn Header="نام نمایشی" Binding="{Binding DisplayName}" Width="*" />
                            <DataGridTextColumn Header="نقش" Binding="{Binding RoleText}" />
                            <DataGridCheckBoxColumn Header="فعال" Binding="{Binding IsActive}" />
                            <DataGridTextColumn Header="آخرین ورود" Binding="{Binding LastLogin}" />
                        </DataGrid.Columns>
                    </DataGrid>
                </DockPanel>
                <ScrollViewer Grid.Column="1" VerticalScrollBarVisibility="Auto">
                    <StackPanel>
                        <Border Style="{StaticResource Card}">
                            <StackPanel>
                                <TextBlock Text="کاربر جدید" Style="{StaticResource SectionTitle}" />
                                <TextBlock Text="نام کاربری" Style="{StaticResource FieldLabel}" />
                                <TextBox Text="{Binding NewUserName, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource LtrInput}" />
                                <TextBlock Text="نام نمایشی" Style="{StaticResource FieldLabel}" />
                                <TextBox Text="{Binding NewDisplayName, UpdateSourceTrigger=PropertyChanged}" />
                                <TextBlock Text="رمز عبور" Style="{StaticResource FieldLabel}" />
                                <PasswordBox x:Name="NewPassword" PasswordChanged="OnNewPassword" FlowDirection="LeftToRight" />
                                <TextBlock Text="{Binding PasswordHint}" Style="{StaticResource Muted}" TextWrapping="Wrap" />
                                <TextBlock Text="نقش" Style="{StaticResource FieldLabel}" />
                                <ComboBox ItemsSource="{Binding Roles}" SelectedItem="{Binding NewRole}" />
                                <Button Content="ایجاد کاربر" Command="{Binding CreateCommand}" Margin="0,10,0,0" />
                            </StackPanel>
                        </Border>
                        <Border Style="{StaticResource Card}">
                            <StackPanel>
                                <TextBlock Text="نقش و دسترسی کاربر انتخاب‌شده" Style="{StaticResource SectionTitle}" />
                                <ComboBox ItemsSource="{Binding Roles}" SelectedItem="{Binding EditRole}" />
                                <CheckBox Content="فعال" IsChecked="{Binding EditActive}" Margin="0,6" />
                                <TextBlock Text="دسترسی‌های اضافه (موارد خاکستری از نقش می‌آیند):" Style="{StaticResource Muted}" TextWrapping="Wrap" />
                                <ItemsControl ItemsSource="{Binding Permissions}">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <CheckBox Content="{Binding Text}" IsChecked="{Binding IsChecked}" IsEnabled="{Binding IsFromRole, Converter={StaticResource InverseBool}}" Margin="0,1" />
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                                <Button Content="ذخیره دسترسی‌ها" Command="{Binding SaveAccessCommand}" Margin="0,10,0,0" />
                            </StackPanel>
                        </Border>
                        <Border Style="{StaticResource Card}">
                            <StackPanel>
                                <TextBlock Text="تغییر رمز کاربر انتخاب‌شده" Style="{StaticResource SectionTitle}" />
                                <TextBlock Text="رمز فعلی (فقط برای حساب خودتان)" Style="{StaticResource FieldLabel}" />
                                <PasswordBox x:Name="CurrentPassword" PasswordChanged="OnCurrentPassword" FlowDirection="LeftToRight" />
                                <TextBlock Text="رمز جدید" Style="{StaticResource FieldLabel}" />
                                <PasswordBox x:Name="ResetPassword" PasswordChanged="OnResetPassword" FlowDirection="LeftToRight" />
                                <Button Content="تغییر رمز" Command="{Binding SetPasswordCommand}" Style="{StaticResource SecondaryButton}" Margin="0,10,0,0" />
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </ScrollViewer>
            </Grid>
        </TabItem>
        <TabItem Header="گزارش رویدادها (Audit)" Visibility="{Binding CanViewAudit, Converter={StaticResource BoolToVis}}">
            <DockPanel Margin="0,8,0,0">
                <Button DockPanel.Dock="Top" HorizontalAlignment="Right" Content="به‌روزرسانی" Command="{Binding RefreshCommand}" Style="{StaticResource SecondaryButton}" Margin="0,0,0,6" />
                <DataGrid ItemsSource="{Binding Audit}" AutoGenerateColumns="False" IsReadOnly="True">
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="زمان" Binding="{Binding Time}" />
                        <DataGridTextColumn Header="کاربر" Binding="{Binding User}" />
                        <DataGridTextColumn Header="عملیات" Binding="{Binding Operation}" />
                        <DataGridTextColumn Header="موجودیت" Binding="{Binding Entity}" />
                        <DataGridTextColumn Header="جزئیات" Binding="{Binding Details}" Width="*" />
                    </DataGrid.Columns>
                </DataGrid>
            </DockPanel>
        </TabItem>
    </TabControl>
</UserControl>
