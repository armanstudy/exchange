<Window x:Class="LenjExchange.Desktop.Views.PromptWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Width="460" SizeToContent="Height" WindowStartupLocation="CenterOwner" ResizeMode="NoResize" ShowInTaskbar="False"
        FontFamily="{StaticResource AppFont}" FontSize="13" FlowDirection="RightToLeft" Background="{StaticResource BackgroundBrush}">
    <StackPanel Margin="18">
        <TextBlock x:Name="MessageText" TextWrapping="Wrap" Margin="0,0,0,10" />
        <TextBox x:Name="Input" MinHeight="32" AcceptsReturn="False" />
        <StackPanel Orientation="Horizontal" HorizontalAlignment="Left" Margin="0,14,0,0">
            <Button Content="تأیید" IsDefault="True" Click="OnOk" MinWidth="90" Margin="0,0,8,0" />
            <Button Content="انصراف" IsCancel="True" Style="{StaticResource SecondaryButton}" MinWidth="90" />
        </StackPanel>
    </StackPanel>
</Window>
