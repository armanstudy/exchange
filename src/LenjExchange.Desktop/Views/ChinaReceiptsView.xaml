<UserControl x:Class="LenjExchange.Desktop.Views.ChinaReceiptsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:v="clr-namespace:LenjExchange.Desktop.Views">
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="330" />
        </Grid.ColumnDefinitions>
        <DockPanel Grid.Column="0" Margin="0,0,12,0">
            <WrapPanel DockPanel.Dock="Top" Margin="0,0,0,6">
                <Button Content="تأیید دریافت" Command="{Binding ApproveCommand}" Margin="0,0,6,0"
                        Visibility="{Binding CanApprove, Converter={StaticResource BoolToVis}}" />
                <Button Content="رد" Command="{Binding RejectCommand}" Style="{StaticResource DangerButton}" Margin="0,0,6,0"
                        Visibility="{Binding CanApprove, Converter={StaticResource BoolToVis}}" />
                <Button Content="برگشت دریافت تأییدشده" Command="{Binding ReverseCommand}" Style="{StaticResource DangerButton}"
                        Visibility="{Binding CanReverse, Converter={StaticResource BoolToVis}}" />
            </WrapPanel>
            <v:MessageBar DockPanel.Dock="Top" />
            <DataGrid ItemsSource="{Binding Items}" SelectedItem="{Binding Selected}" AutoGenerateColumns="False" IsReadOnly="True">
                <DataGrid.Columns>
                    <DataGridTextColumn Header="پرونده" Binding="{Binding CaseNumber}" />
                    <DataGridTextColumn Header="نماینده" Binding="{Binding Agent}" />
                    <DataGridTextColumn Header="گیرنده" Binding="{Binding Recipient}" />
                    <DataGridTextColumn Header="تاریخ" Binding="{Binding Date}" />
                    <DataGridTextColumn Header="تسویه دلاری" Binding="{Binding SettledUsd}" />
                    <DataGridTextColumn Header="پرداختی" Binding="{Binding Paid}" />
                    <DataGridTextColumn Header="نرخ" Binding="{Binding Rate}" />
                    <DataGridTextColumn Header="پیگیری" Binding="{Binding TrackingNo}" />
                    <DataGridTextColumn Header="وضعیت" Binding="{Binding Approval}" Width="*" />
                </DataGrid.Columns>
            </DataGrid>
        </DockPanel>

        <ScrollViewer Grid.Column="1" VerticalScrollBarVisibility="Auto">
            <StackPanel>
                <Border Style="{StaticResource Card}">
                    <StackPanel>
                        <TextBlock Text="ثبت دریافت در چین" Style="{StaticResource SectionTitle}" />
                        <TextBlock Text="پرونده *" Style="{StaticResource FieldLabel}" />
                        <ComboBox ItemsSource="{Binding Cases}" SelectedItem="{Binding FormCase}" />
                        <TextBlock Text="نماینده ارسال‌کننده *" Style="{StaticResource FieldLabel}" />
                        <ComboBox ItemsSource="{Binding Agents}" SelectedItem="{Binding FormAgent}" />
                        <TextBlock Text="گیرنده نهایی *" Style="{StaticResource FieldLabel}" />
                        <ComboBox ItemsSource="{Binding Recipients}" SelectedItem="{Binding FormRecipient}" />
                        <TextBlock Text="تاریخ" Style="{StaticResource FieldLabel}" />
                        <TextBox Text="{Binding FormDate, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource LtrInput}" />
                        <TextBlock Text="مبلغ دلاری تسویه‌شده از نماینده (USD) *" Style="{StaticResource FieldLabel}" />
                        <TextBox Text="{Binding FormSettledUsd, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource LtrInput}" />
                        <TextBlock Text="ارز پرداختی به گیرنده" Style="{StaticResource FieldLabel}" />
                        <ComboBox ItemsSource="{Binding RecipientCurrencies}" SelectedItem="{Binding FormPaidCurrency}" />
                        <StackPanel Visibility="{Binding NeedsRate, Converter={StaticResource BoolToVis}}">
                            <TextBlock Text="نرخ: هر ۱ USD چند واحد ارز پرداختی؟ *" Style="{StaticResource FieldLabel}" />
                            <DockPanel>
                                <Button DockPanel.Dock="Left" Content="آخرین نرخ" Command="{Binding LoadLatestRateCommand}" Style="{StaticResource SecondaryButton}" Margin="6,0,0,0" />
                                <TextBox Text="{Binding FormRate, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource LtrInput}" />
                            </DockPanel>
                        </StackPanel>
                        <TextBlock Text="{Binding FormPaidPreview}" FontWeight="Bold" Foreground="{StaticResource PrimaryBrush}" Margin="0,6,0,0" TextWrapping="Wrap" />
                        <TextBlock Text="شماره پیگیری" Style="{StaticResource FieldLabel}" />
                        <TextBox Text="{Binding FormTrackingNo, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource LtrInput}" />
                        <TextBlock Text="یادداشت" Style="{StaticResource FieldLabel}" />
                        <TextBox Text="{Binding FormNotes, UpdateSourceTrigger=PropertyChanged}" />
                        <Button Content="ثبت دریافت" Command="{Binding RegisterCommand}" Margin="0,12,0,0" />
                    </StackPanel>
                </Border>
                <Border Style="{StaticResource Card}" Visibility="{Binding CanManageMasterData, Converter={StaticResource BoolToVis}}">
                    <StackPanel>
                        <TextBlock Text="ارزهای قابل دریافت گیرنده انتخاب‌شده" Style="{StaticResource SectionTitle}" />
                        <CheckBox Content="دلار (USD)" IsChecked="{Binding RecipientUsd}" />
                        <CheckBox Content="یوان (CNY)" IsChecked="{Binding RecipientCny}" />
                        <CheckBox Content="تتر (USDT)" IsChecked="{Binding RecipientUsdt}" />
                        <WrapPanel Margin="0,8,0,0">
                            <Button Content="ذخیره ارزها" Command="{Binding SaveRecipientCurrenciesCommand}" Style="{StaticResource SecondaryButton}" Margin="0,0,6,0" />
                            <Button Content="افزودن گیرنده" Command="{Binding AddRecipientCommand}" Style="{StaticResource SecondaryButton}" />
                        </WrapPanel>
                    </StackPanel>
                </Border>
            </StackPanel>
        </ScrollViewer>
    </Grid>
</UserControl>
