<UserControl x:Class="LenjExchange.Desktop.Views.LoginView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Grid>
        <Border Style="{StaticResource Card}" Width="440" HorizontalAlignment="Center" VerticalAlignment="Center" Padding="28">
            <StackPanel>
                <Image Source="/Assets/lenj-logo.png" Width="72" Height="72" HorizontalAlignment="Center" Margin="0,0,0,8" RenderOptions.BitmapScalingMode="HighQuality" />
                <TextBlock Text="سامانه مالی لنج" FontSize="24" FontWeight="Bold" Foreground="{StaticResource PrimaryBrush}" HorizontalAlignment="Center" />
                <TextBlock Text="شرکت بازرگانی لنج – برادران بارگاهی" Foreground="{StaticResource BrandSecondaryBrush}" Style="{StaticResource Muted}" HorizontalAlignment="Center" Margin="0,4,0,18" />

                <Border Style="{StaticResource WarningBox}" Visibility="{Binding IsFirstRun, Converter={StaticResource BoolToVis}}">
                    <TextBlock TextWrapping="Wrap" Text="این اولین اجرای برنامه است. برای ادامه، حساب مدیر سیستم را با رمز عبور دلخواه و قوی بسازید. برنامه رمز پیش‌فرض ندارد." />
                </Border>

                <TextBlock Text="نام کاربری" Style="{StaticResource FieldLabel}" />
                <TextBox Text="{Binding UserName, UpdateSourceTrigger=PropertyChanged}" FlowDirection="LeftToRight" />

                <StackPanel Visibility="{Binding IsFirstRun, Converter={StaticResource BoolToVis}}">
                    <TextBlock Text="نام نمایشی" Style="{StaticResource FieldLabel}" />
                    <TextBox Text="{Binding DisplayName, UpdateSourceTrigger=PropertyChanged}" />
                </StackPanel>

                <TextBlock Text="رمز عبور" Style="{StaticResource FieldLabel}" />
                <PasswordBox x:Name="Password" PasswordChanged="OnPasswordChanged" FlowDirection="LeftToRight" />

                <StackPanel Visibility="{Binding IsFirstRun, Converter={StaticResource BoolToVis}}">
                    <TextBlock Text="تکرار رمز عبور" Style="{StaticResource FieldLabel}" />
                    <PasswordBox x:Name="Confirm" PasswordChanged="OnConfirmChanged" FlowDirection="LeftToRight" />
                    <TextBlock Text="{Binding PasswordHint}" Style="{StaticResource Muted}" Margin="0,4,0,0" />
                </StackPanel>

                <TextBlock Text="{Binding ErrorMessage}" Foreground="{StaticResource DangerBrush}" TextWrapping="Wrap" Margin="0,10,0,0" />
                <Button Content="ادامه" Command="{Binding SubmitCommand}" IsDefault="True" Margin="0,14,0,0" HorizontalAlignment="Stretch" />
            </StackPanel>
        </Border>
    </Grid>
</UserControl>
