<UserControl x:Class="LenjExchange.Desktop.Views.AgentsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:v="clr-namespace:LenjExchange.Desktop.Views">
    <DockPanel>
        <Border DockPanel.Dock="Top" Style="{StaticResource Card}">
            <StackPanel>
                <TextBlock Text="دلار نزد هر نماینده" Style="{StaticResource SectionTitle}" />
                <ItemsControl ItemsSource="{Binding Balances}">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate><WrapPanel /></ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Border Style="{StaticResource StatCard}" MinWidth="200">
                                <StackPanel>
                                    <TextBlock Text="{Binding Name}" Style="{StaticResource Muted}" />
                                    <TextBlock Text="{Binding Amounts}" FontSize="18" FontWeight="Bold" FlowDirection="LeftToRight" HorizontalAlignment="Right" />
                                </StackPanel>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </StackPanel>
        </Border>
        <WrapPanel DockPanel.Dock="Top" Margin="0,4">
            <CheckBox Content="فقط تحویل‌های در انتظار تأیید" IsChecked="{Binding PendingOnly}" VerticalAlignment="Center" Margin="0,0,12,0" />
            <Button Content="تأیید دریافت" Command="{Binding ApproveCommand}" Margin="0,0,6,0"
                    Visibility="{Binding CanApprove, Converter={StaticResource BoolToVis}}" />
            <Button Content="رد" Command="{Binding RejectCommand}" Style="{StaticResource DangerButton}" Margin="0,0,6,0"
                    Visibility="{Binding CanApprove, Converter={StaticResource BoolToVis}}" />
            <Button Content="برگشت تحویل تأییدشده" Command="{Binding ReverseCommand}" Style="{StaticResource DangerButton}" Margin="0,0,6,0"
                    Visibility="{Binding CanReverse, Converter={StaticResource BoolToVis}}" />
            <Button Content="به‌روزرسانی" Command="{Binding RefreshCommand}" Style="{StaticResource SecondaryButton}" Margin="0,0,6,0" />
            <Button Content="افزودن نماینده" Command="{Binding AddAgentCommand}" Style="{StaticResource SecondaryButton}"
                    Visibility="{Binding CanManageMasterData, Converter={StaticResource BoolToVis}}" />
        </WrapPanel>
        <v:MessageBar DockPanel.Dock="Top" />
        <DataGrid ItemsSource="{Binding Items}" SelectedItem="{Binding Selected}" AutoGenerateColumns="False" IsReadOnly="True">
            <DataGrid.Columns>
                <DataGridTextColumn Header="کد رهگیری" Binding="{Binding TrackingNo}" />
                <DataGridTextColumn Header="کد صرافی" Binding="{Binding ExternalNo}" />
                <DataGridTextColumn Header="پرونده" Binding="{Binding CaseNumber}" />
                <DataGridTextColumn Header="صرافی" Binding="{Binding Exchanger}" />
                <DataGridTextColumn Header="نماینده" Binding="{Binding Agent}" />
                <DataGridTextColumn Header="تاریخ" Binding="{Binding Date}" />
                <DataGridTextColumn Header="مبلغ" Binding="{Binding Amount}" />
                <DataGridTextColumn Header="وضعیت" Binding="{Binding Approval}" Width="*" />
            </DataGrid.Columns>
        </DataGrid>
    </DockPanel>
</UserControl>
