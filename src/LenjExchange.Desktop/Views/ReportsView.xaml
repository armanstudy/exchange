<UserControl x:Class="LenjExchange.Desktop.Views.ReportsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:v="clr-namespace:LenjExchange.Desktop.Views">
    <DockPanel>
        <Border DockPanel.Dock="Top" Style="{StaticResource Card}">
            <StackPanel>
                <WrapPanel>
                    <StackPanel Margin="0,0,10,6">
                        <TextBlock Text="نوع گزارش" Style="{StaticResource FieldLabel}" />
                        <ComboBox ItemsSource="{Binding Kinds}" SelectedItem="{Binding Kind}" Width="200" />
                    </StackPanel>
                    <StackPanel Margin="0,0,10,6" Visibility="{Binding IsStatement, Converter={StaticResource BoolToVis}}">
                        <TextBlock Text="مشتری" Style="{StaticResource FieldLabel}" />
                        <ComboBox ItemsSource="{Binding CustomerOptions}" SelectedItem="{Binding Customer}" IsEditable="True" Width="230" />
                    </StackPanel>
                    <StackPanel Margin="0,0,10,6">
                        <TextBlock Text="بازه زمانی" Style="{StaticResource FieldLabel}" />
                        <ComboBox ItemsSource="{Binding Presets}" SelectedItem="{Binding Preset}" Width="140" />
                    </StackPanel>
                    <StackPanel Margin="0,0,10,6" Visibility="{Binding NeedsDates, Converter={StaticResource BoolToVis}}">
                        <TextBlock Text="از تاریخ / روز" Style="{StaticResource FieldLabel}" />
                        <TextBox Text="{Binding FromDate, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource LtrInput}" Width="110" />
                    </StackPanel>
                    <StackPanel Margin="0,0,10,6" Visibility="{Binding NeedsDates, Converter={StaticResource BoolToVis}}">
                        <TextBlock Text="تا تاریخ" Style="{StaticResource FieldLabel}" />
                        <TextBox Text="{Binding ToDate, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource LtrInput}" Width="110" />
                    </StackPanel>
                    <StackPanel Margin="0,0,10,6">
                        <TextBlock Text="ارز" Style="{StaticResource FieldLabel}" />
                        <ComboBox ItemsSource="{Binding Currencies}" SelectedItem="{Binding Currency}" Width="110" />
                    </StackPanel>
                    <StackPanel Margin="0,0,10,6" Visibility="{Binding IsStatement, Converter={StaticResource BoolToVis}}">
                        <TextBlock Text="نوع عملیات" Style="{StaticResource FieldLabel}" />
                        <ComboBox ItemsSource="{Binding OperationTypes}" SelectedItem="{Binding OpType}" Width="150" />
                    </StackPanel>
                    <CheckBox Content="بدون اسناد برگشتی" IsChecked="{Binding ExcludeReversed}" VerticalAlignment="Bottom" Margin="0,0,10,12"
                              Visibility="{Binding IsStatement, Converter={StaticResource BoolToVis}}" />
                </WrapPanel>
                <WrapPanel>
                    <Button Content="نمایش گزارش" Command="{Binding RunReportCommand}" IsDefault="True" Margin="0,0,8,0" />
                    <Button Content="خروجی PDF" Command="{Binding ExportPdfCommand}" Style="{StaticResource SecondaryButton}" Margin="0,0,8,0"
                            Visibility="{Binding CanExport, Converter={StaticResource BoolToVis}}" IsEnabled="{Binding HasPdf}" />
                    <Button Content="خروجی Excel" Command="{Binding ExportExcelCommand}" Style="{StaticResource SecondaryButton}"
                            Visibility="{Binding CanExport, Converter={StaticResource BoolToVis}}" />
                </WrapPanel>
            </StackPanel>
        </Border>
        <v:MessageBar DockPanel.Dock="Top" />
        <TextBlock DockPanel.Dock="Top" Text="{Binding RangeText}" Style="{StaticResource Muted}" Margin="0,0,0,4" />
        <Border DockPanel.Dock="Bottom" Style="{StaticResource Card}" Visibility="{Binding SummaryText, Converter={StaticResource NullToCollapsed}}">
            <TextBlock Text="{Binding SummaryText}" TextWrapping="Wrap" FontWeight="Bold" LineHeight="22" />
        </Border>
        <DataGrid x:Name="ReportGrid" ItemsSource="{Binding Rows}" AutoGenerateColumns="False" IsReadOnly="True">
            <DataGrid.Columns>
                <DataGridTextColumn Binding="{Binding C1}" />
                <DataGridTextColumn Binding="{Binding C2}" />
                <DataGridTextColumn Binding="{Binding C3}" />
                <DataGridTextColumn Binding="{Binding C4}" Width="*" />
                <DataGridTextColumn Binding="{Binding C5}" />
                <DataGridTextColumn Binding="{Binding C6}" />
                <DataGridTextColumn Binding="{Binding C7}" />
                <DataGridTextColumn Binding="{Binding C8}" />
            </DataGrid.Columns>
        </DataGrid>
    </DockPanel>
</UserControl>
